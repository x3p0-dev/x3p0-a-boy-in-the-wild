{
	"name": "x3p0-dev/x3p0-a-boy-in-the-wild",
	"type": "wordpress-theme",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"build": [
			"composer update --no-dev",
			"composer dump-autoload -o --no-dev"
		],
		"dev": [
			"composer update",
			"composer dump-autoload"
		],
		"post-install-cmd": [
			"@x3p0-dev-scripts"
		],
		"post-update-cmd": [
			"@x3p0-dev-scripts"
		],
		"lint:php": "./vendor/bin/phpcs -d error_reporting=E_ALL^E_DEPRECATED -s --colors .",
		"x3p0-dev-scripts": "X3P0\\ABoyInTheWild\\Scripts\\ComposerScripts::devScripts",
		"zip": "composer archive --file=x3p0-a-boy-in-the-wild"
	},
	"extra": {
		"x3p0": {
			"prelude": {
				"prefix": "X3P0\\ABoyInTheWild",
				"output-path": "packages",
				"packages": {
					"x3p0-dev/x3p0-asset": {
						"replace": "X3P0\\"
					},
					"x3p0-dev/x3p0-framework": {
						"replace": "X3P0\\"
					}
				}
			},
			"skills": {
				"path": ".claude/skills"
			}
		}
	},
	"autoload": {
		"psr-4": {
			"X3P0\\ABoyInTheWild\\": "src/",
			"X3P0\\ABoyInTheWild\\Asset\\": "packages/x3p0-dev/x3p0-asset/src/",
			"X3P0\\ABoyInTheWild\\Framework\\": "packages/x3p0-dev/x3p0-framework/src/"
		},
		"files": [
			"src/functions-helpers.php"
		],
		"classmap": [
			"packages/"
		],
		"exclude-from-classmap": [
			"vendor/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"X3P0\\ABoyInTheWild\\Scripts\\": "scripts/"
		}
	},
	"require": {
		"php": ">=8.1",
		"x3p0-dev/x3p0-asset": "dev-master",
		"x3p0-dev/x3p0-framework": "dev-master"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "*",
		"symfony/var-dumper": "^6.4",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"x3p0-dev/x3p0-prelude": "dev-master",
		"x3p0-dev/x3p0-skills": "dev-master"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"archive-dir": "./",
		"archive-format": "zip"
	},
	"archive": {
		"exclude": [
			"/vendor",
			"!/vendor/autoload.php",
			"!/vendor/composer/"
		]
	},
	"authors": [
		{
			"name": "Justin Tadlock",
			"email": "justintadlock@gmail.com"
		}
	]
}
