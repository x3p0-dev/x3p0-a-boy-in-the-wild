{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/wp/6.8/schemas/json/theme.json",
	"version": 3,
	"title": "Subtle",
	"description": "Normalizes the text and gives it a subtle ink color.",
	"slug": "text-subtle",
	"blockTypes": [
		"core/heading",
		"core/paragraph"
	],
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--ink-subtle)"
		},
		"typography": {
			"fontFamily": "inherit",
			"fontSize": "inherit",
			"fontStyle": "inherit",
			"fontWeight": "inherit",
			"letterSpacing": "revert",
			"lineHeight": "inherit",
			"textTransform": "inherit"
		},
		"elements": {
			"link": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "inherit",
					"fontStyle": "inherit",
					"fontWeight": "inherit",
					"letterSpacing": "revert",
					"lineHeight": "inherit",
					"textTransform": "inherit"
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--ink-accent)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ink-accent)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			}
		}
	}
}
