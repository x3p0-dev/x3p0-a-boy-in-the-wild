{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Caption",
	"slug": "text-caption",
	"blockTypes": [
		"core/heading",
		"core/paragraph",
		"core/post-author-biography",
		"core/post-date",
		"core/post-excerpt",
		"core/term-description"
	],
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--ink-accent)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--tertiary)",
			"fontSize": "1.125em",
			"lineHeight": "var(--wp--custom--line-height--lg)",
			"fontStyle": "normal"
		}
	}
}
