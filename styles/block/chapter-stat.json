{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chapter Stat",
	"slug": "chapter-stat",
	"blockTypes": ["core/group"],
	"styles": {
		"border": {
			"bottom": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "1px"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)",
					"fontSize": "var(--wp--preset--font-size--title-md)",
					"fontWeight": "400",
					"lineHeight": "1"
				}
			}
		}
	}
}
