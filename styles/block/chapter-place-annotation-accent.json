{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chapter Place Annotation — Accent",
	"slug": "chapter-place-annotation-accent",
	"blockTypes": ["core/group"],
	"styles": {
		"color": {
			"background": "color-mix(in oklab, var(--wp--preset--color--parchment-accent) 38%, transparent)"
		},
		"border": {
			"top": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "1px"
			},
			"bottom": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "1px"
			},
			"left": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "1px"
			},
			"right": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "1px"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--tertiary)",
					"fontSize": "var(--wp--preset--font-size--md)"
				}
			}
		}
	}
}
