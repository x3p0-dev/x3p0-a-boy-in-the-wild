{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Slash",
	"slug": "separator-slash",
	"blockTypes": ["core/separator"],
	"styles": {
		"color": {
			"text": "inherit"
		},
		"typography": {
			"fontFamily": "inherit",
			"fontSize": "inherit",
			"lineHeight": "inherit"
		},
		"border": {
			"top": {
				"width": "0px"
			}
		},
		"dimensions": {
			"minHeight": "0"
		},
		"css": "&::before { font-size: inherit; content: '\\002F'; display: block; }"
	}
}
