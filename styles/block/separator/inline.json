{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Inline",
	"slug": "separator-inline",
	"blockTypes": ["core/separator"],
	"styles": {
		"color": {
			"background": "transparent",
			"text": "inherit"
		},
		"typography": {
			"fontFamily": "inherit",
			"fontSize": "inherit",
			"lineHeight": "inherit"
		},
		"border": {
			"width": "0"
		},
		"spacing": {
			"margin": {
				"top": "0",
				"bottom": "0"
			}
		},
		"dimensions": {
			"minHeight": "0"
		},
		"css": "mask: none; &::before { font-size: inherit; content: var(--wp--custom--mark--separator); display: block; background: none; mask: none; }"
	}
}
