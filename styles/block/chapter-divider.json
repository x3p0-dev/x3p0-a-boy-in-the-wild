{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chapter Divider",
	"slug": "chapter-divider",
	"blockTypes": ["core/separator"],
	"styles": {
		"border": {
			"top": {
				"color": "currentColor",
				"style": "solid",
				"width": "1px"
			}
		},
		"color": {
			"text": "var(--wp--preset--color--rule)"
		},
		"spacing": {
			"margin": {
				"top": "var(--wp--preset--spacing--70)",
				"bottom": "var(--wp--preset--spacing--70)"
			}
		},
		"css": "width: 40px;"
	}
}
