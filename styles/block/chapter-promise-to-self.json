{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chapter Promise to Self",
	"slug": "chapter-promise-to-self",
	"blockTypes": ["core/paragraph"],
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--tertiary)",
			"fontSize": "var(--wp--preset--font-size--lg)",
			"lineHeight": "1.75"
		},
		"color": {
			"text": "var(--wp--preset--color--ink-subtle)"
		},
		"border": {
			"top": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "var(--wp--preset--spacing--px)"
			},
			"bottom": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "var(--wp--preset--spacing--px)"
			},
			"left": { "width": "0" },
			"right": { "width": "0" }
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--50)",
				"bottom": "var(--wp--preset--spacing--50)",
				"left": "0",
				"right": "0"
			},
			"margin": {
				"bottom": "var(--wp--preset--spacing--80)"
			}
		}
	}
}
