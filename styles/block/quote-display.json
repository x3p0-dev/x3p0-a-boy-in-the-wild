{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Display",
	"slug": "quote-display",
	"blockTypes": ["core/quote"],
	"styles": {
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "0",
				"right": "0"
			}
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--3-xl)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--3-xl)"
		},
		"elements": {
			"cite": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--tertiary)",
					"fontSize": "var(--wp--preset--font-size--caption)",
					"fontStyle": "normal"
				},
				"color": {
					"text": "var(--wp--preset--color--ink-muted)"
				}
			}
		}
	}
}
