{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"blockTypes": ["core/group","core/paragraph", "core/post-excerpt"],
	"title": "Chapter Meta",
	"slug": "chapter-meta",
	"styles": {
		"css": "& .wp-block-post-excerpt__more-link {\n\tdisplay: none !important;\n}",
		"color": {
			"text": "var(--wp--preset--color--ink-subtle)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--tertiary)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"lineHeight": "var(--wp--custom--line-heigh--md)"
		}
	}
}
