{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Chapter Pull Quote",
	"slug": "chapter-pull-quote",
	"blockTypes": ["core/quote"],
	"styles": {
		"spacing": {
			"margin": {
				"left": "0",
				"right": "0"
			},
			"padding": {
				"top": "var(--wp--preset--spacing--70)",
				"bottom": "var(--wp--preset--spacing--70)",
				"left": "0",
				"right": "0"
			}
		},
		"border": {
			"top": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "1px"
			},
			"bottom": {
				"color": "var(--wp--preset--color--rule)",
				"style": "solid",
				"width": "1px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--3-xl)",
			"fontStyle": "italic",
			"fontWeight": "400",
			"lineHeight": "1.1"
		},
		"color": {
			"text": "var(--wp--preset--color--ink)"
		},
		"elements": {
			"cite": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--tertiary)",
					"fontSize": "var(--wp--preset--font-size--caption)",
					"fontStyle": "normal"
				},
				"color": {
					"text": "var(--wp--preset--color--ink-muted)"
				}
			}
		}
	}
}
