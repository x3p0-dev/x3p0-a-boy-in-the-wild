{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Bordered",
	"slug": "container-bordered",
	"blockTypes": [
		"core/column",
		"core/columns",
		"core/group"
	],
	"styles": {
		"css": "corner-shape: var(--wp--custom--corner--global--shape);",
		"border": {
			"color": "var(--wp--preset--color--rule)",
			"style": "var(--wp--custom--border--global--style)",
			"width": "var(--wp--custom--border--global--width)",
			"radius": "var(--wp--custom--border--global--radius)"
		}
	}
}
